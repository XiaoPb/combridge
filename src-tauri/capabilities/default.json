{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$RESOURCE/**" }, { "path": "$CWD/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$CWD/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$CWD/**" }]
    }
  ]
}
